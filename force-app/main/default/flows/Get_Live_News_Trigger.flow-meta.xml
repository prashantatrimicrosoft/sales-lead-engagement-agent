        </outputAssignments>
        <outputAssignments>
            <assignToReference>varTriggerTimestamp</assignToReference>
            <field>published_timestamp__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varTriggerType</assignToReference>
            <field>trigger_type__c</field>
        </outputAssignments>
        <sortField>published_timestamp__c</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Live_News_Trigger</targetReference>
