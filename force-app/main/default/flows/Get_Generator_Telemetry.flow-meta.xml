<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Retrieves all generator telemetry records for an account from the unified Data Cloud grounding layer (Snowflake, via Zero-Copy federation), including fault codes, fuel level, and maintenance status. Returns all units for the account, since some accounts have multiple installed units.</description>
    <environments>Default</environments>
    <interviewLabel>Get Generator Telemetry {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Generator Telemetry</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_Generator_Telemetry</name>
        <label>get Generator Telemetry</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>account_id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </filters>
        <object>Generator_Telemetry_DMO__dlm</object>
        <outputAssignments>
            <assignToReference>FAULT_CODES_30D</assignToReference>
            <field>fault_codes_30d__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>FUEL_LEVEL_PCT</assignToReference>
            <field>fuel_level_pct__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>LAST_FAULT_DESCRIPTION</assignToReference>
            <field>last_fault_description__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>NEXT_MAINTENANCE_DUE</assignToReference>
            <field>next_maintenance_due__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>UNIT_ID</assignToReference>
            <field>unit_id__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>UNIT_STATUS</assignToReference>
            <field>unit_status__c</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>get_Generator_Telemetry</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>FAULT_CODES_30D</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>FUEL_LEVEL_PCT</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>LAST_FAULT_DESCRIPTION</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>NEXT_MAINTENANCE_DUE</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>UNIT_ID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>UNIT_STATUS</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
